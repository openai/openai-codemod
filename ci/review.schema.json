{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "persona": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "failure": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "persona",
          "severity",
          "file",
          "line",
          "title",
          "evidence",
          "failure",
          "fix"
        ]
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "still_open",
              "unclear"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "persona",
    "head",
    "findings",
    "resolutions"
  ]
}
